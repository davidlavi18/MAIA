# ============================================================
# Maia — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================


# ── Core ─────────────────────────────────────────────────────
# MongoDB connection string
# Docker: mongodb://mongodb:27017/
MONGO_URI=mongodb://localhost:27017

# MongoDB database name
MAIA_DB_NAME=maia

# Redis connection string (used by ARQ, Celery, SSE, cache)
# Docker: redis://redis-stack:6379/0
REDIS_URL=redis://localhost:6379/0

# Secret key for signing JWT tokens — use a long random string
MAIA_JWT_SECRET=change_me_to_a_random_secret

# Allowed CORS origin for the dashboard (Vite dev server)
FRONTEND_URL=http://localhost:5173

# Public URL of this API (Twilio Voice webhooks, Gmail push, OAuth callbacks).
# For local dev with Twilio Voice / Gmail push: use ngrok — ngrok http 8000
# WAHA webhooks use WAHA_WEBHOOK_BASE_URL (below) instead, http://fastapi:8000 inside docker compose
BACKEND_URL=http://localhost:8000

# Basic Auth for the OpenAPI docs (/docs)
MAIA_DOCS_USER=admin
MAIA_DOCS_PASSWORD=change_me

# Set to true to route AI responses through the ARQ worker (recommended in production)
# When false, responses are processed inline in the FastAPI process
USE_ARQ_WORKER=false


# ── AI ───────────────────────────────────────────────────────
# Platform shared LLM keys — used as fallback when a tenant has no
# per-tenant key configured.
MAIA_OPENAI_API_KEY=sk-...
MAIA_ANTHROPIC_API_KEY=
MAIA_GOOGLE_API_KEY=

# OpenAI Realtime model for phone calls (GA interface). Fallback example: gpt-realtime
MAIA_REALTIME_MODEL=gpt-realtime-2.1

# Cohere API key — embeddings + rerank for the RAG
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v4.0-pro



# ── Vector Database (Qdrant) ────────────────────────────────
# Local Qdrant (Docker): set HOST=qdrant, PORT=6333
QDRANT_HOST=localhost
QDRANT_PORT=6333


# ── Google ───────────────────────────────────────────────────
# Google OAuth — required for Calendar and Gmail integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Path to GCP service account JSON (GCS media storage, Gmail push via Pub/Sub)
GOOGLE_APPLICATION_CREDENTIALS=serviceKey.json
# GCP project of that service account (owns the Pub/Sub topic for Gmail push)
GCP_PROJECT_ID=
# Cloud Storage bucket for uploaded files (public read; the service account needs Storage Admin)
GCS_BUCKET=


# ── WhatsApp via WAHA ───────────────────────
# Local WAHA container (docker-compose.waha.yml): http://waha:3000
WAHA_API_KEY=
WAHA_BASE_URL=http://waha:3000
# Base URL WAHA posts webhooks to. Local compose: http://fastapi:8000 (internal network).
# Empty = BACKEND_URL (the public URL, e.g. ngrok), which must then be up when sessions are created.
WAHA_WEBHOOK_BASE_URL=http://fastapi:8000
